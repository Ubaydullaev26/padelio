# Скопируйте в .env и заполните под своё окружение.
# Значения ниже соответствуют infra/docker-compose.yml (локальная разработка).

DATABASE_URL=postgres://padelio:padelio@localhost:5432/padelio
REDIS_URL=redis://localhost:6379
API_PORT=3000

# Секрет подписи сессионных JWT (в production — обязательный, длинный случайный)
JWT_SECRET=

# Telegram: токен бота от @BotFather (нужен и боту, и API для проверки initData)
BOT_TOKEN=

# Публичный HTTPS-адрес Mini App (кнопка в боте)
MINIAPP_URL=

# CORS для API (домены Mini App через запятую); пусто = разрешить всё (dev)
CORS_ORIGIN=

# Mini App: адрес API (пусто = относительный /api через vite-прокси в dev)
VITE_API_URL=
